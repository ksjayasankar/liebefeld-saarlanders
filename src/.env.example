# Every setting the system reads. Copy to .env; no defaults exist in code.
DB_PASSWORD=change-me
# Host-side development uses the published port 5433 (decision D-03); compose overrides this for the api service.
DATABASE_URL=postgresql://navigator:change-me@localhost:5433/navigator
APERTUS_BASE_URL="https://gateway.keera.ch/api/v1"
APERTUS_API_KEY="<key issued at the hackathon>"
APERTUS_8B=apertus-v1-5-8b
APERTUS_70B=apertus-v1-5-70b
# Parallel Apertus calls, below the limit measured by gateway-check
APERTUS_PARALLEL=8
SHOW_NAMES=false
# Fetch: user agent naming the project and its repository; days before `fetch --refresh` re-checks a page
FETCH_USER_AGENT="HackApertus-ResearchNavigator/0.1 (+https://github.com/jayasankarks/research-navigator)"
REFRESH_DAYS=7
DOMAINS=medtech
# torch device for BGE-M3 and the reranker: cpu | mps | cuda
TORCH_DEVICE=cpu
# Number of fused chunks per need sent to the reranker (spec 6.3: 50; lower if the timing check says so)
RERANK_TOP=50
# Front-end calls (comma-separated origins allowed by the API)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Per-address limit on endpoints that call Apertus, requests per minute
RATE_LIMIT_PER_MINUTE=20
